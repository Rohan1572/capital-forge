# Copy to `.env` and fill in the values. `.env` is git-ignored.

# Include `?sslmode=require` for hosted Postgres providers.
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# Required for the AI critique, debate, and risk routes. Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
# Any slug from https://openrouter.ai/models that supports structured outputs; the
# risk and shock routes send a strict JSON schema. The default is free but has a
# small daily request budget.
OPENROUTER_MODEL="qwen/qwen3.8-27b:free"
# "deny" avoids providers that train on prompts, but excludes the free tier.
OPENROUTER_DATA_COLLECTION="allow"
# Optional. App attribution for the OpenRouter leaderboards.
# OPENROUTER_SITE_URL="http://localhost:3000"
# OPENROUTER_APP_TITLE="CapitalForge"

# Cost accounting in USD per 1M tokens. 0 reports every call as free.
AI_INPUT_COST_PER_1M_TOKENS="0"
AI_OUTPUT_COST_PER_1M_TOKENS="0"

# Risk-free rate used in the Sharpe ratio. Both must match or the client and
# server compute different values.
RISK_FREE_RATE="0.02"
NEXT_PUBLIC_RISK_FREE_RATE="0.02"

# Required in production. Verifies `Authorization: Bearer <CRON_SECRET>` on /api/cron/*.
CRON_SECRET="your-cron-secret"
# Verifies `x-admin-secret: <ADMIN_TRIGGER_SECRET>` on /api/admin/*.
ADMIN_TRIGGER_SECRET="your-admin-trigger-secret"

# Signs password-reset tokens. Required in production; the app throws on
# startup without it. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RESET_TOKEN_SECRET="your-reset-token-secret"

# --- Optional: only read by the `ops:*` scripts, which load this file
# automatically, so a value set here is picked up by `npm run ops:*`. ---

# `ops:restore:check` validates a restored backup. Point it at the restored copy
# so the gate does not touch the live database; falls back to DATABASE_URL.
# RESTORED_DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# `ops:monitoring:check` smoke-tests the monitoring route with a live session.
# MONITORING_COOKIE="cf_session=your-session-value"
# MONITORING_URL="http://localhost:3000/api/monitoring?days=30"
