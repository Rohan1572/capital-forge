# Copy to `.env` and fill in the values. `.env` is git-ignored.

# Database. Include `?sslmode=require` for hosted Postgres providers.
DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# OpenAI. Required for the AI critique, debate, and risk routes.
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-4.1-mini"
# Keep false unless you want OpenAI to retain responses.
OPENAI_STORE_RESPONSES="false"

# AI cost accounting, USD per 1M tokens. 0 disables cost reporting.
AI_INPUT_COST_PER_1M_TOKENS="0"
AI_OUTPUT_COST_PER_1M_TOKENS="0"

# Risk-free rate for the Sharpe ratio. Both must match.
RISK_FREE_RATE="0.02"
NEXT_PUBLIC_RISK_FREE_RATE="0.02"

# Operator secrets, required in production.
# Verifies `Authorization: Bearer <CRON_SECRET>` on /api/cron/*.
CRON_SECRET="your-cron-secret"
# Verifies `x-admin-secret: <ADMIN_TRIGGER_SECRET>` on /api/admin/*.
ADMIN_TRIGGER_SECRET="your-admin-trigger-secret"

# Signs password-reset tokens. Required in production; the app throws on
# startup without it. Generate:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
RESET_TOKEN_SECRET="your-reset-token-secret"

# --- Operational gates (optional; only used by the `ops:*` scripts) ---
# These are read by scripts/ops/*, which load this file automatically, so a
# value set here is picked up by `npm run ops:*` without an inline export.

# `ops:restore:check` validates a restored backup. Point this at the restored
# copy so the gate does not touch the live database; falls back to DATABASE_URL.
# RESTORED_DATABASE_URL="postgres://user:password@host:5432/database?sslmode=require"

# `ops:monitoring:check` smoke-tests the monitoring route. Needs an
# authenticated session, for example `cf_session=<value>`.
# MONITORING_COOKIE="cf_session=your-session-value"
# MONITORING_URL="http://localhost:3000/api/monitoring?days=30"
