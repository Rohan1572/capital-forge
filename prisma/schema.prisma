// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model SimulationRun {
  id                   String   @id @default(cuid())
  userId               String?
  strategyId           String?
  name                 String
  status               String   @default("draft")
  assumptionsVersion   String?
  assumptions          Json?
  seed                 Int?
  shockId              String?
  shockModifiers       Json?
  results              Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  strategy             Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([strategyId])
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())
  sessions     Session[]
  strategies   Strategy[]
  simulationRuns SimulationRun[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Strategy {
  id                   String   @id @default(cuid())
  userId               String
  allocation           Json
  metrics              Json
  assumptionsVersion   String?
  assumptions          Json?
  seed                 Int?
  shockId              String?
  shockModifiers       Json?
  simulationResults    Json?
  simulationSeed       Int?
  simulationMode       String?
  simulationShock      Json?
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  simulationRuns       SimulationRun[]

  @@index([userId])
}

model AiResponseLog {
  id         String   @id @default(cuid())
  strategyId String?
  kind       String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([strategyId])
  @@index([kind])
  @@index([createdAt])
}

model ShockEvent {
  id           String   @id @default(cuid())
  title        String
  description  String
  marketImpact Json
  modifiers    Json
  active       Boolean  @default(false)
  weekStart    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
  @@index([weekStart])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
}
model LeaderboardSeason {
  id          String   @id @default(cuid())
  scope       String   @unique
  activeMonth String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
