# Normalize line endings in the repository so that a checkout on Windows does
# not rewrite files to CRLF. Without this, `core.autocrlf=true` rewrites LF files
# on clone and `prettier --check` fails on the `endOfLine: lf` rule in
# .prettierrc.json / .editorconfig.

# Default: check out text files with LF, and normalize CRLF on commit.
* text=auto eol=lf

# Windows scripts must keep CRLF to execute.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files that must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.webm binary
*.pdf binary
*.zip binary
*.gz binary

# Generated by Next.js; not committed.
next-env.d.ts text eol=lf

# Lockfiles are not line-ending sensitive but should still be normalized.
package-lock.json text eol=lf